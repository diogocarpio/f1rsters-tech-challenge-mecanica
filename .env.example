# AWS Credentials - Tech Challenge
# Este arquivo é um template para configuração de credenciais
# Copie para .env e preencha com suas credenciais reais
# NÃO commitar o arquivo .env com credenciais reais

AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
AWS_DEFAULT_REGION=sa-east-1

# AWS S3 Buckets
AWS_TERRAFORM_STATE_BUCKET=f1rsters-tech-challenge-terraform-state
AWS_LAMBDA_ARTIFACTS_BUCKET=f1rsters-tech-challenge-lambda-artifacts

# Project Configuration
PROJECT_NAME=f1rsters-tech-challenge-mecanica
ENVIRONMENT=dev
